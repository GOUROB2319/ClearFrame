<Window x:Class="ClearFrame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClearFrame" Height="340" Width="440"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <StackPanel Margin="24">
        <TextBlock Text="ClearFrame" FontSize="26" FontWeight="Bold"/>
        <TextBlock Text="Phase 1 - Region recorder" Foreground="Gray" Margin="0,0,0,18"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Text="X"      HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Y"      HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="Width"  HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="Height" HorizontalAlignment="Center"/>

            <TextBox x:Name="XBox"      Grid.Row="1" Grid.Column="0" Margin="3" Padding="4" TextAlignment="Center"/>
            <TextBox x:Name="YBox"      Grid.Row="1" Grid.Column="1" Margin="3" Padding="4" TextAlignment="Center"/>
            <TextBox x:Name="WidthBox"  Grid.Row="1" Grid.Column="2" Margin="3" Padding="4" TextAlignment="Center"/>
            <TextBox x:Name="HeightBox" Grid.Row="1" Grid.Column="3" Margin="3" Padding="4" TextAlignment="Center"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Text="Frame rate:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="FpsBox" Width="90" SelectedIndex="0">
                <ComboBoxItem Content="30 FPS"/>
                <ComboBoxItem Content="60 FPS"/>
            </ComboBox>
        </StackPanel>

        <Button x:Name="RecordButton" Content="Start Recording" Height="46"
                FontSize="16" Margin="0,20,0,0" Click="RecordButton_Click"/>

        <TextBlock x:Name="StatusText" Text="Ready" TextWrapping="Wrap" Margin="0,14,0,0"/>
    </StackPanel>
</Window>
